# --- Payload CMS -------------------------------------------------------

# Postgres connection string. On the VPS this is the local instance:
# postgres://USER:PASSWORD@localhost:5432/dentv2
DATABASE_URL=

# Signs auth tokens. Any long random string — `openssl rand -base64 32`.
# Changing it logs every admin user out.
PAYLOAD_SECRET=

# Where uploaded images are stored. MUST be outside the repository in
# production — a path inside it is wiped on every deploy, taking the
# client's uploads with it. On the VPS, something like:
#   MEDIA_DIR=/var/www/dentv2-media
# Leave empty in development and uploads go to <repo>/media, which is
# gitignored. Whatever path you choose, back it up: the database alone
# does not contain the images.
MEDIA_DIR=


# Booking persistence and secondary notifications (src/app/api/booking/route.ts)
#
# A request is accepted once Payload persists it in PostgreSQL. Missing or
# failing notification providers never remove or reject a stored request.

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be a domain verified in Resend, e.g. "Total Charm Dent <site@totalcharmdent.ge>"
BOOKING_FROM=

# Backwards-compatible email recipient used only while Booking Settings >
# Notification email is empty. This is separate from the public Clinic Info email.
BOOKING_INBOX=vake_dent@tcc.ge

# Optional private Telegram booking alert. Both values are required to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
