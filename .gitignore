# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# payload uploads — content, not code. In production this lives outside the
# repo entirely; see MEDIA_DIR in .env.example.
/media

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. `.env*` was swallowing it, which meant the one file
# that documents what the server needs never reached the server.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
